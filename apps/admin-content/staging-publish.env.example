# Server-only hosted staging publication values.
# Never expose STAGING_SUPABASE_SECRET_KEY through VITE_* variables or browser code.
STAGING_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
STAGING_SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF

# Public-site deny-list and canonical host for generated staging Species pages.
STAGING_PUBLIC_SITE_URL=https://YOUR_STAGING_SITE.vercel.app
PRODUCTION_PUBLIC_SITE_URL=https://aqua-tank-guide.vercel.app
STAGING_SOURCE_LABEL=aquaguide-hosted-staging

# Explicit allowlist; maximum 20 Species. Never omit this for staging release.
STAGING_CATALOG_KEYS=sp_0030

# Before any real Business Admin operator acceptance, run the read-only gate below.
# It refuses Production and requires Admin schema + representative Product/Care/Compatibility data.
# npm run check:business-admin-staging

# Optional representative-data preparation for a dedicated non-Production Business Admin environment.
# Default mode is dry-run. `--commit` is refused unless the target is non-Production and schema_ready=true.
# Species/Care are imported from the canonical repo catalog as published metadata only; large asset uploads are skipped.
# The same command then reconciles the canonical reviewed Compatibility baseline (13 Evidence / 7 Profiles / 4 Pair Rules).
# It does NOT create an Auth user or grant an Admin role; provision the authorized staging admin identity separately.
# npm run seed:business-admin-staging
# npm run seed:business-admin-staging -- --commit
