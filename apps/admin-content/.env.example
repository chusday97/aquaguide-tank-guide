# Species SEO Admin defaults to the GitHub Repo-backed content backend.
# No database credential or GitHub token belongs in VITE_ browser variables.

# Optional read-only UI demo mode. Normal Vercel Preview remains writable after Admin login.
# VITE_ADMIN_READ_ONLY_DEMO=true

# Server-only translation provider values are configured on Vercel, not exposed to the browser.
AI_API_KEY=MY_AI_API_KEY
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
