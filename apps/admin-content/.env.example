# Browser-safe Supabase values used by the Admin UI.
# Never put SUPABASE_SERVICE_ROLE_KEY in this app.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only translation provider values for /api/translate.
# Keep AI secrets WITHOUT a VITE_ prefix so Vite never exposes them to browser code.
AI_API_KEY=MY_AI_API_KEY
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
