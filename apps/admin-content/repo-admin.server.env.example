# SERVER-ONLY values for the Repo-backed Species SEO Admin.
ADMIN_REPO_EMAIL=admin@example.com
ADMIN_REPO_PASSWORD_HASH=scrypt:replace-with-generated-value
ADMIN_REPO_SESSION_SECRET=replace-with-at-least-32-random-characters

# One fine-grained token may cover exactly these two selected repositories.
# Required permission: Contents = Read and write. No Actions/Workflow permission is needed.
ADMIN_GITHUB_TOKEN=github-fine-grained-token-with-contents-write

# Private editorial authority: Draft / Review / Revision never live in the public AquaGuide repo.
ADMIN_GITHUB_CONTENT_REPO=owner/aquaguide-seo-content
ADMIN_GITHUB_DRAFT_BRANCH=seo-admin-drafts
ADMIN_GITHUB_SOURCE_BRANCH=main
ADMIN_GITHUB_CONTENT_PATH=content/species-seo/admin-store.json

# Public application repo receives only sanitized, explicit staging snapshots.
ADMIN_GITHUB_STAGING_REPO=owner/aquaguide-tank-guide
ADMIN_GITHUB_STAGING_BRANCH=feature/admin-content-v0
ADMIN_GITHUB_STAGING_SNAPSHOT_PATH=content/species-seo/staging-snapshot.json
