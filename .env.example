# AquaGuide Supabase
# Keep real values in .env.local or your deployment platform's environment variables.
# Never commit SUPABASE_SECRET_KEY or other real secrets.

# Browser / Vite: safe-to-expose project URL + publishable key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Backend API: project URL + publishable key for user-scoped Supabase clients.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Backend only: elevated key. Never prefix this with VITE_ and never expose it to the browser.
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"

# Use a separate random application secret for signed AquaGuide share tokens.
SHARE_TOKEN_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Legacy Supabase key names remain supported by the code temporarily for compatibility:
# VITE_SUPABASE_ANON_KEY="..."
# SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."

# AI API Key: used only by the local/backend server.
# Create .env.local and put your real key there. Do not commit .env.local.
AI_API_KEY="MY_AI_API_KEY"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-v4-flash"
# Optional local/Vercel timeout override in milliseconds. Default is 20000.
AI_TIMEOUT_MS="20000"

# Legacy DeepSeek names are still supported for compatibility.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DeepSeek official OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Default cheap/fast model. You can switch to deepseek-v4-pro if needed.
DEEPSEEK_MODEL="deepseek-v4-flash"

# Local API server port. Vite proxies /api to this port in development.
API_PORT="8787"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional feedback email delivery. Feedback is saved to the database first.
RESEND_API_KEY="MY_RESEND_API_KEY"
FEEDBACK_EMAIL_TO="feedback@example.com"
FEEDBACK_EMAIL_FROM="AquaGuide <feedback@your-verified-domain.example>"
